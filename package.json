{
  "name": "zhuifen", "version": "0.1.0", "private": true,
  "workspaces": ["packages/shared", "apps/api", "apps/web"],
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:internal": "concurrently -k -n API,WEB \"npm run dev -w @zhuifen/api\" \"npm run dev -w @zhuifen/web\"",
    "build": "node scripts/run.mjs build",
    "build:internal": "npm run build -w @zhuifen/api && npm run build -w @zhuifen/web",
    "typecheck": "node scripts/run.mjs typecheck",
    "typecheck:internal": "npm run typecheck --workspaces",
    "test": "node scripts/run.mjs test",
    "test:internal": "npm run test --workspaces --if-present",
    "test:integration": "node scripts/run.mjs test:integration",
    "test:integration:internal": "npm run test:integration -w @zhuifen/api",
    "test:e2e": "node scripts/run.mjs test:e2e",
    "test:e2e:internal": "playwright test",
    "setup:node": "npm install --prefix .tools --registry=https://registry.npmjs.org/ --no-package-lock --no-audit --no-fund node@24.21.0"
  },
  "devDependencies": {"@playwright/test": "^1.64.1", "concurrently": "^9.2.1"},
  "engines": {"node": "^22.22.3 || >=24.15.0"}
}
