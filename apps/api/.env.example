DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zhuifen
PORT=3001
# Comma-separated frontend origins. Add your LAN IP to test with phones.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 部署在反向代理后面时填写代理层数（如 Caddy 填 1），用于限流识别真实 IP。
# TRUST_PROXY=1
# 托管平台提供不可伪造的真实 IP 请求头时填写，例如 Render 填 true-client-ip。
# CLIENT_IP_HEADER=
# 超过多少天没有任何操作的房间会被自动清理。
# ROOM_RETENTION_DAYS=7
